# Runtime mode: development, test or production
RESOLVEOS_AI_APP_ENV=development

# Enable interactive API documentation during local development.
RESOLVEOS_AI_DOCS_ENABLED=true

# Required only for Gemini provider use and the live smoke test
RESOLVEOS_AI_GEMINI_API_KEY=
RESOLVEOS_AI_GEMINI_MODEL=gemini-3.8-flash
RESOLVEOS_AI_GEMINI_TIMEOUT_SECONDS=60