generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  GITHUB
}

enum Role {
  OBSERVER
  ENGINEER
  INCIDENT_COMMANDER
  ADMIN
}

enum JobRole {
  SOFTWARE_ENGINEER
  SITE_RELIABILITY_ENGINEER
  DEVOPS_PLATFORM_ENGINEER
  ENGINEERING_MANAGER
  INCIDENT_COMMANDER
  OTHER
}

enum TeamSize {
  ONE_TO_FIVE
  SIX_TO_TWENTY
  TWENTY_ONE_TO_FIFTY
  FIFTY_ONE_TO_TWO_HUNDRED
  TWO_HUNDRED_PLUS
}

enum PrimaryResponsibility {
  APPLICATION_ENGINEERING
  RELIABILITY_SRE
  PLATFORM_ENGINEERING
  INFRASTRUCTURE
  ENGINEERING_LEADERSHIP
  OTHER
}

model User {
  id                        String                 @id @default(uuid())
  fullName                  String
  email                     String                 @unique
  passwordHash              String?
  authProvider              AuthProvider
  emailVerified             Boolean                @default(false)
  jobRole                   JobRole?
  teamSize                  TeamSize?
  primaryResponsibility     PrimaryResponsibility?
  verificationCode          String?
  verificationAttempts      Int                    @default(0)
  verificationCodeExpires   DateTime?
  passwordResetTokenHash    String?                @unique
  passwordResetTokenExpires DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  memberships               Membership[]
}

// Matches connect-pg-simple's expected table exactly (sid/sess/expire),
// so express-session can use it as its store. Modeled here (rather than
// letting connect-pg-simple create it itself) so it's tracked by Prisma's
// own migration history instead of showing up as untracked drift later.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}
